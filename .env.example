# Optional: use Formspree instead of the local Resend route.
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Required by /api/subscribe when Formspree is not configured.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Optional footer links. Leave blank to hide them.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GITHUB_URL=

# Paddle Billing Pro lifetime purchase verification (server only).
# Create a one-time $19 price in Paddle and use its price ID here.
PADDLE_API_KEY=
PADDLE_PRO_PRICE_ID=
PADDLE_ENVIRONMENT=sandbox
